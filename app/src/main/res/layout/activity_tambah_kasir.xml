<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/emerald_soft"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Tambah Kasir Baru"
        android:textColor="@color/emerald_dark"
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etNamaKasirBaru"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/edittext_background"
        android:hint="Nama Lengkap Kasir"
        android:paddingHorizontal="16dp" />

    <EditText
        android:id="@+id/etUsernameKasirBaru"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edittext_background"
        android:hint="Username untuk Login"
        android:paddingHorizontal="16dp" />

    <EditText
        android:id="@+id/etPasswordKasirBaru"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edittext_background"
        android:hint="Password"
        android:inputType="textPassword"
        android:paddingHorizontal="16dp" />

    <Button
        android:id="@+id/btnSimpanKasir"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/emerald_primary"
        android:text="Simpan Akun Kasir"
        android:textAllCaps="false"
        android:textStyle="bold" />

</LinearLayout>